<Window x:Class="DoneToday.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DoneToday"
        Title="Done Today"
        Icon="icon.ico"
        Height="540" Width="440"
        MinHeight="200" MinWidth="280"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="{StaticResource Brush.Bg}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="Trebuchet MS, Segoe UI"
        FontSize="16">
    <Window.Resources>
        <local:DoneToTextDecorationsConverter x:Key="DoneToStrike"/>
        <local:DoneToBrushConverter x:Key="DoneToBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                x:Name="UpdateBanner"
                Visibility="Collapsed"
                Background="{StaticResource Brush.Accent}"
                CornerRadius="4"
                Padding="10,6"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           x:Name="UpdateBannerText"
                           Text=""
                           Foreground="White"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
                <Button Grid.Column="1"
                        x:Name="UpdateInstallButton"
                        Content="Install"
                        Margin="8,0,0,0"
                        Padding="10,3"
                        Background="White"
                        Foreground="{StaticResource Brush.AccentDim}"
                        BorderThickness="0"
                        Cursor="Hand"
                        FontWeight="SemiBold"
                        Click="UpdateInstall_Click"/>
                <Button Grid.Column="2"
                        Content="✕"
                        Width="22" Height="22"
                        Padding="0"
                        Margin="6,0,0,0"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Dismiss"
                        Click="UpdateDismiss_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource Brush.BgAlt}"
                BorderBrush="{StaticResource Brush.BorderSubtle}"
                BorderThickness="1"
                CornerRadius="4">
            <TextBox x:Name="AddBox"
                     Padding="8"
                     Background="Transparent"
                     Foreground="{StaticResource Brush.Text}"
                     BorderThickness="0"
                     CaretBrush="{StaticResource Brush.AccentBright}"
                     KeyDown="AddBox_KeyDown"
                     ToolTip="Type a task and press Enter to add">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Resources>
                            <VisualBrush x:Key="HintBrush" TileMode="None" Opacity="0.6" Stretch="None" AlignmentX="Left">
                                <VisualBrush.Visual>
                                    <TextBlock Text="Add a task and press Enter…"
                                               Foreground="#B4BCCC"
                                               Margin="2,0,0,0"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Style.Resources>
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="Click&#x00A0;to&#x00A0;mark&#x00A0;done  ·  Ctrl+click&#x00A0;edits&#x00A0;time  ·  Right-click&#x00A0;for&#x00A0;notes  ·  Drag&#x00A0;to&#x00A0;reorder"
                   Foreground="{StaticResource Brush.TextMuted}"
                   FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontRatio}, ConverterParameter=0.7}"
                   Margin="2,4,2,0"
                   TextWrapping="Wrap"/>

        <ListBox x:Name="TodoList"
                 Grid.Row="3"
                 Margin="0,8,0,8"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="{StaticResource Brush.Text}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AlternationCount="9999"
                 AllowDrop="True"
                 PreviewMouseLeftButtonDown="TodoList_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="TodoList_PreviewMouseMove"
                 Drop="TodoList_Drop"
                 DragOver="TodoList_DragOver"
                 DragLeave="TodoList_DragLeave"
                 KeyDown="TodoList_KeyDown">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="Margin" Value="0,2"/>
                    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.PriorityBg}"/>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.AccentBright}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="ItemsControl.AlternationIndex" Value="0"/>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.PriorityBgHover}"/>
                                    </MultiTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid MouseLeftButtonUp="Item_MouseLeftButtonUp"
                          MouseRightButtonUp="Item_MouseRightButtonUp"
                          ToolTip="{Binding Details}"
                          ToolTipService.InitialShowDelay="500"
                          ToolTipService.IsEnabled="{Binding HasDetails}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Done, Converter={StaticResource DoneToBrush}, ConverterParameter=glyph}"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="14"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Done, Converter={StaticResource DoneToBrush}}"/>

                        <!-- Display mode -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Text}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Done, Converter={StaticResource DoneToBrush}}"
                                   TextDecorations="{Binding Done, Converter={StaticResource DoneToStrike}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Edit mode -->
                        <TextBox Grid.Column="1"
                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource Brush.BgAlt}"
                                 Foreground="{StaticResource Brush.Text}"
                                 BorderBrush="{StaticResource Brush.Accent}"
                                 BorderThickness="1"
                                 CaretBrush="{StaticResource Brush.AccentBright}"
                                 Padding="4,2"
                                 VerticalContentAlignment="Center"
                                 IsVisibleChanged="EditBox_IsVisibleChanged"
                                 KeyDown="EditBox_KeyDown"
                                 LostKeyboardFocus="EditBox_LostFocus">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Button Grid.Column="2"
                                Content="{Binding SubtaskBadge}"
                                Style="{StaticResource RowIconButton}"
                                Background="{StaticResource Brush.BgAlt}"
                                BorderBrush="{StaticResource Brush.Accent}"
                                MinWidth="44"
                                Padding="8,0"
                                Margin="4,0,0,0"
                                FontWeight="SemiBold"
                                ToolTip="Open subtasks"
                                Click="Subtasks_Click"/>
                        <TextBlock Grid.Column="3"
                                   Text="🗒"
                                   FontFamily="Segoe UI Emoji"
                                   FontSize="13"
                                   Margin="4,0,2,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.AccentBright}"
                                   Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisHidden}}"
                                   ToolTip="Has notes — right-click to view"/>
                        <Button Grid.Column="4"
                                Content="✎"
                                Style="{StaticResource RowIconButton}"
                                Margin="4,0,0,0"
                                ToolTip="Edit"
                                Click="Edit_Click"/>
                        <Button Grid.Column="5"
                                Content="✕"
                                Style="{StaticResource RowIconButton}"
                                Margin="4,0,0,0"
                                ToolTip="Delete"
                                Click="Delete_Click"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       x:Name="StatusText"
                       Foreground="{StaticResource Brush.TextMuted}"
                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontRatio}, ConverterParameter=0.7}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}"
                        Padding="10,2"
                        ToolTip="Hide done items from this list (they stay in the file)"
                        Click="ArchiveDone_Click">
                    <StackPanel>
                        <TextBlock Text="Archive"
                                   HorizontalAlignment="Center"
                                   FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontRatio}, ConverterParameter=0.7}"/>
                        <TextBlock Text="completed"
                                   HorizontalAlignment="Center"
                                   FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontRatio}, ConverterParameter=0.7}"/>
                    </StackPanel>
                </Button>
                <Button Content="📋"
                        Style="{StaticResource GhostButton}"
                        Margin="6,0,0,0"
                        FontFamily="Segoe UI Emoji"
                        FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontRatio}, ConverterParameter=0.81}"
                        ToolTip="View completed tasks (for ADO review)"
                        Click="Completed_Click"/>
                <Button Content="🗃"
                        Style="{StaticResource GhostButton}"
                        Margin="6,0,0,0"
                        FontFamily="Segoe UI Emoji"
                        FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontRatio}, ConverterParameter=0.81}"
                        ToolTip="Archived items (browse / unarchive)"
                        Click="Archived_Click"/>
                <Button Content="⚙"
                        Style="{StaticResource GhostButton}"
                        Margin="6,0,0,0"
                        FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource FontRatio}, ConverterParameter=0.81}"
                        ToolTip="Settings"
                        Click="Settings_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

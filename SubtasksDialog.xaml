<Window x:Class="DoneToday.SubtasksDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DoneToday"
        Title="Subtasks"
        Icon="icon.ico"
        Width="460" Height="540"
        MinWidth="320" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource Brush.Bg}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="Trebuchet MS, Segoe UI"
        FontSize="14">
    <Window.Resources>
        <local:DoneToTextDecorationsConverter x:Key="DoneToStrike"/>
        <local:DoneToBrushConverter x:Key="DoneToBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="↳ "
                       Foreground="{StaticResource Brush.AccentBright}"
                       FontSize="16"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="ParentTitle"
                       Text=""
                       FontWeight="SemiBold"
                       FontSize="15"
                       Foreground="{StaticResource Brush.Text}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource Brush.BgAlt}"
                BorderBrush="{StaticResource Brush.BorderSubtle}"
                BorderThickness="1"
                CornerRadius="4">
            <TextBox x:Name="AddBox"
                     Padding="8"
                     Background="Transparent"
                     Foreground="{StaticResource Brush.Text}"
                     BorderThickness="0"
                     CaretBrush="{StaticResource Brush.AccentBright}"
                     KeyDown="AddBox_KeyDown">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Resources>
                            <VisualBrush x:Key="HintBrush" TileMode="None" Opacity="0.6" Stretch="None" AlignmentX="Left">
                                <VisualBrush.Visual>
                                    <TextBlock Text="Add a subtask and press Enter…"
                                               Foreground="#B4BCCC"
                                               Margin="2,0,0,0"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Style.Resources>
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="Click&#x00A0;to&#x00A0;mark&#x00A0;done  ·  Ctrl+click&#x00A0;edits&#x00A0;time  ·  Right-click&#x00A0;for&#x00A0;notes  ·  Drag&#x00A0;or&#x00A0;Alt+↑/↓&#x00A0;to&#x00A0;reorder"
                   Foreground="{StaticResource Brush.TextMuted}"
                   FontSize="11"
                   Margin="2,4,2,0"
                   TextWrapping="Wrap"/>

        <ListBox x:Name="SubList"
                 Grid.Row="3"
                 Margin="0,8,0,8"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="{StaticResource Brush.Text}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AllowDrop="True"
                 PreviewMouseLeftButtonDown="SubList_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="SubList_PreviewMouseMove"
                 Drop="SubList_Drop"
                 DragOver="SubList_DragOver"
                 DragLeave="SubList_DragLeave"
                 KeyDown="SubList_KeyDown">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="Margin" Value="0,2"/>
                    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SurfaceHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid MouseLeftButtonUp="Item_MouseLeftButtonUp"
                          MouseRightButtonUp="Item_MouseRightButtonUp"
                          ToolTip="{Binding Details}"
                          ToolTipService.InitialShowDelay="500"
                          ToolTipService.IsEnabled="{Binding HasDetails}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Done, Converter={StaticResource DoneToBrush}, ConverterParameter=glyph}"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="14"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Done, Converter={StaticResource DoneToBrush}}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Text}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Done, Converter={StaticResource DoneToBrush}}"
                                   TextDecorations="{Binding Done, Converter={StaticResource DoneToStrike}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBox Grid.Column="1"
                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource Brush.BgAlt}"
                                 Foreground="{StaticResource Brush.Text}"
                                 BorderBrush="{StaticResource Brush.Accent}"
                                 BorderThickness="1"
                                 CaretBrush="{StaticResource Brush.AccentBright}"
                                 Padding="4,2"
                                 VerticalContentAlignment="Center"
                                 IsVisibleChanged="EditBox_IsVisibleChanged"
                                 KeyDown="EditBox_KeyDown"
                                 LostKeyboardFocus="EditBox_LostFocus">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <TextBlock Grid.Column="2"
                                   Text="🗒"
                                   FontFamily="Segoe UI Emoji"
                                   FontSize="13"
                                   Margin="4,0,2,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.AccentBright}"
                                   Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisHidden}}"
                                   ToolTip="Has notes — right-click to view"/>
                        <Button Grid.Column="3"
                                Content="✎"
                                Style="{StaticResource RowIconButton}"
                                Margin="4,0,0,0"
                                ToolTip="Edit"
                                Click="Edit_Click"/>
                        <Button Grid.Column="4"
                                Content="✕"
                                Style="{StaticResource RowIconButton}"
                                Margin="4,0,0,0"
                                ToolTip="Delete"
                                Click="Delete_Click"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       x:Name="StatusText"
                       Foreground="{StaticResource Brush.TextMuted}"
                       FontSize="11"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Clear done"
                        Style="{StaticResource GhostButton}"
                        Click="ClearDone_Click"/>
                <Button Content="Close"
                        Style="{StaticResource GhostButton}"
                        Margin="6,0,0,0"
                        IsCancel="True"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

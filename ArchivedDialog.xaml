<Window x:Class="DoneToday.ArchivedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DoneToday"
        Title="Archived items"
        Icon="icon.ico"
        Width="540" Height="560"
        MinWidth="380" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource Brush.Bg}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="Trebuchet MS, Segoe UI"
        FontSize="14">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Archived items"
                       FontWeight="SemiBold"
                       FontSize="16"
                       Foreground="{StaticResource Brush.Text}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       x:Name="StatusText"
                       Foreground="{StaticResource Brush.TextMuted}"
                       FontSize="12"
                       VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,8">
            <TextBlock Text="Range:"
                       Foreground="{StaticResource Brush.TextMuted}"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"/>
            <ComboBox x:Name="RangeCombo"
                      Width="140"
                      Background="{StaticResource Brush.BgAlt}"
                      Foreground="{StaticResource Brush.Text}"
                      BorderBrush="{StaticResource Brush.Border}"
                      SelectionChanged="RangeCombo_SelectionChanged">
                <ComboBoxItem Content="All time" Tag="All" IsSelected="True"/>
                <ComboBoxItem Content="Today" Tag="Today"/>
                <ComboBoxItem Content="Yesterday" Tag="Yesterday"/>
                <ComboBoxItem Content="Last 7 days" Tag="Last7"/>
                <ComboBoxItem Content="Last 14 days" Tag="Last14"/>
                <ComboBoxItem Content="Last 30 days" Tag="Last30"/>
                <ComboBoxItem Content="Last 90 days" Tag="Last90"/>
                <ComboBoxItem Content="Custom…" Tag="Custom"/>
            </ComboBox>
            <StackPanel x:Name="CustomRow" Orientation="Horizontal" Visibility="Collapsed" Margin="8,0,0,0">
                <TextBlock Text="From"
                           Foreground="{StaticResource Brush.TextMuted}"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>
                <DatePicker x:Name="FromPicker" Width="120" SelectedDateChanged="CustomDate_Changed"/>
                <TextBlock Text="To"
                           Foreground="{StaticResource Brush.TextMuted}"
                           VerticalAlignment="Center"
                           Margin="8,0,4,0"/>
                <DatePicker x:Name="ToPicker" Width="120" SelectedDateChanged="CustomDate_Changed"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2"
                Background="{StaticResource Brush.BgAlt}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <ScrollViewer x:Name="ContentScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="10">
                    <ItemsControl x:Name="DaysList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding DateLabel}"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="{StaticResource Brush.AccentBright}"
                                               Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding Entries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="6,3,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding TitleText}"
                                                                   Foreground="{StaticResource Brush.Text}"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding MetaText}"
                                                                   Foreground="{StaticResource Brush.TextMuted}"
                                                                   FontSize="11"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="↩  Unarchive"
                                                            Style="{StaticResource GhostButton}"
                                                            Margin="6,0,0,0"
                                                            Click="Unarchive_Click"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText"
                           Text="No archived items in this range."
                           Foreground="{StaticResource Brush.TextMuted}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1"
                    Content="Close"
                    Style="{StaticResource GhostButton}"
                    IsCancel="True"
                    Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>

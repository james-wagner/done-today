<Window x:Class="DoneToday.CompletedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DoneToday"
        Title="Completed tasks"
        Icon="icon.ico"
        Width="520" Height="540"
        MinWidth="380" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource Brush.Bg}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="Trebuchet MS, Segoe UI"
        FontSize="14">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Completed tasks"
                           FontWeight="SemiBold"
                           FontSize="16"
                           Foreground="{StaticResource Brush.Text}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           x:Name="StatusText"
                           Foreground="{StaticResource Brush.TextMuted}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Range:"
                           Foreground="{StaticResource Brush.TextMuted}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <ComboBox x:Name="RangeCombo"
                          Width="140"
                          Background="{StaticResource Brush.BgAlt}"
                          Foreground="{StaticResource Brush.Text}"
                          BorderBrush="{StaticResource Brush.Border}"
                          SelectionChanged="RangeCombo_SelectionChanged">
                    <ComboBoxItem Content="All time" Tag="All" IsSelected="True"/>
                    <ComboBoxItem Content="Today" Tag="Today"/>
                    <ComboBoxItem Content="Yesterday" Tag="Yesterday"/>
                    <ComboBoxItem Content="Last 7 days" Tag="Last7"/>
                    <ComboBoxItem Content="Last 14 days" Tag="Last14"/>
                    <ComboBoxItem Content="Last 30 days" Tag="Last30"/>
                    <ComboBoxItem Content="Last 90 days" Tag="Last90"/>
                    <ComboBoxItem Content="Custom…" Tag="Custom"/>
                </ComboBox>
                <StackPanel x:Name="CustomRow" Orientation="Horizontal" Visibility="Collapsed" Margin="8,0,0,0">
                    <TextBlock Text="From"
                               Foreground="{StaticResource Brush.TextMuted}"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"/>
                    <DatePicker x:Name="FromPicker"
                                Width="120"
                                SelectedDateChanged="CustomDate_Changed"/>
                    <TextBlock Text="To"
                               Foreground="{StaticResource Brush.TextMuted}"
                               VerticalAlignment="Center"
                               Margin="8,0,4,0"/>
                    <DatePicker x:Name="ToPicker"
                                Width="120"
                                SelectedDateChanged="CustomDate_Changed"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource Brush.BgAlt}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <ScrollViewer x:Name="ContentScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="10">
                    <ItemsControl x:Name="DaysList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding DateLabel}"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="{StaticResource Brush.AccentBright}"
                                               Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding Entries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="6,3,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="• "
                                                               Foreground="{StaticResource Brush.TextMuted}"
                                                               VerticalAlignment="Top"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding DisplayText}"
                                                                   Foreground="{StaticResource Brush.Text}"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding DurationText}"
                                                                   Foreground="{StaticResource Brush.AccentBright}"
                                                                   FontSize="12"
                                                                   Margin="0,2,0,0"
                                                                   Visibility="{Binding HasDuration, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBlock Text="{Binding Details}"
                                                                   Foreground="{StaticResource Brush.TextMuted}"
                                                                   FontStyle="Italic"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,0"
                                                                   Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyText"
                           Text="No completed tasks yet."
                           Foreground="{StaticResource Brush.TextMuted}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Clear all"
                        Style="{StaticResource GhostButton}"
                        Click="Clear_Click"/>
                <Button Content="Copy log path"
                        Style="{StaticResource GhostButton}"
                        Margin="6,0,0,0"
                        ToolTip="Copy the absolute path of completed.log.json (e.g. for Claude Code to read)"
                        Click="CopyPath_Click"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Copy for ADO"
                        Style="{StaticResource AccentButton}"
                        Click="Copy_Click"
                        MinWidth="120"/>
                <Button Content="Close"
                        Style="{StaticResource GhostButton}"
                        Margin="6,0,0,0"
                        IsCancel="True"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

<Window x:Class="DoneToday.DetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task details"
        Icon="icon.ico"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource Brush.Bg}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="Trebuchet MS, Segoe UI"
        FontSize="14">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Task"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource Brush.Text}"
                   Margin="0,0,0,4"/>

        <Border Grid.Row="1"
                Background="{StaticResource Brush.BgAlt}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="4">
            <TextBox x:Name="TitleBox"
                     Background="Transparent"
                     Foreground="{StaticResource Brush.Text}"
                     BorderThickness="0"
                     CaretBrush="{StaticResource Brush.AccentBright}"
                     Padding="8,6"
                     VerticalContentAlignment="Center"
                     KeyDown="TitleBox_KeyDown"/>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="Notes"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource Brush.Text}"
                   Margin="0,14,0,4"/>

        <Border Grid.Row="3"
                Background="{StaticResource Brush.BgAlt}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="4">
            <TextBox x:Name="NotesBox"
                     Background="Transparent"
                     Foreground="{StaticResource Brush.Text}"
                     BorderThickness="0"
                     CaretBrush="{StaticResource Brush.AccentBright}"
                     Padding="8,6"
                     MinHeight="180"
                     AcceptsReturn="True"
                     AcceptsTab="False"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>
        </Border>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource GhostButton}"
                    Click="Cancel_Click"/>
            <Button Content="Save"
                    Style="{StaticResource AccentButton}"
                    Margin="6,0,0,0"
                    MinWidth="64"
                    IsDefault="True"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="DoneToday.CompleteAtDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mark complete at"
        Icon="icon.ico"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource Brush.Bg}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="Trebuchet MS, Segoe UI"
        FontSize="14">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock x:Name="TaskTitle"
                       Text=""
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.Text}"/>
            <TextBlock x:Name="CreatedLabel"
                       Text=""
                       Foreground="{StaticResource Brush.TextDim}"
                       FontSize="12"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="When was this completed?"
                   Foreground="{StaticResource Brush.TextMuted}"
                   Margin="0,0,0,8"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Text="Date:"
                       Foreground="{StaticResource Brush.TextMuted}"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"/>
            <DatePicker x:Name="DatePicker"
                        Width="150"
                        VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Time:"
                       Foreground="{StaticResource Brush.TextMuted}"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"/>
            <TextBox x:Name="HourBox"
                     Width="44"
                     MaxLength="2"
                     Padding="4,3"
                     TextAlignment="Center"
                     Background="{StaticResource Brush.BgAlt}"
                     Foreground="{StaticResource Brush.Text}"
                     BorderBrush="{StaticResource Brush.Border}"
                     CaretBrush="{StaticResource Brush.AccentBright}"/>
            <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0"/>
            <TextBox x:Name="MinuteBox"
                     Width="44"
                     MaxLength="2"
                     Padding="4,3"
                     TextAlignment="Center"
                     Background="{StaticResource Brush.BgAlt}"
                     Foreground="{StaticResource Brush.Text}"
                     BorderBrush="{StaticResource Brush.Border}"
                     CaretBrush="{StaticResource Brush.AccentBright}"/>
            <TextBlock Text="(24-hour)"
                       Foreground="{StaticResource Brush.TextDim}"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Margin="8,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock Text="How long did this take?"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Text}"
                       Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="DurHourBox"
                         Width="48"
                         MaxLength="3"
                         Padding="4,3"
                         TextAlignment="Center"
                         Background="{StaticResource Brush.BgAlt}"
                         Foreground="{StaticResource Brush.Text}"
                         BorderBrush="{StaticResource Brush.Border}"
                         CaretBrush="{StaticResource Brush.AccentBright}"/>
                <TextBlock Text="hours"
                           Foreground="{StaticResource Brush.TextMuted}"
                           VerticalAlignment="Center"
                           Margin="6,0,12,0"/>
                <TextBox x:Name="DurMinuteBox"
                         Width="48"
                         MaxLength="2"
                         Padding="4,3"
                         TextAlignment="Center"
                         Background="{StaticResource Brush.BgAlt}"
                         Foreground="{StaticResource Brush.Text}"
                         BorderBrush="{StaticResource Brush.Border}"
                         CaretBrush="{StaticResource Brush.AccentBright}"/>
                <TextBlock Text="minutes"
                           Foreground="{StaticResource Brush.TextMuted}"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0"/>
            </StackPanel>
            <TextBlock Text="(approximate hands-on time — leave blank if not tracking)"
                       Foreground="{StaticResource Brush.TextDim}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Now"
                    Style="{StaticResource GhostButton}"
                    Click="Now_Click"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Cancel"
                        Style="{StaticResource GhostButton}"
                        IsCancel="True"
                        Click="Cancel_Click"/>
                <Button Content="OK"
                        Style="{StaticResource AccentButton}"
                        Margin="6,0,0,0"
                        MinWidth="64"
                        IsDefault="True"
                        Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

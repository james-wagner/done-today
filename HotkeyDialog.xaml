<Window x:Class="DoneToday.HotkeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Icon="icon.ico"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource Brush.Bg}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="Trebuchet MS, Segoe UI"
        FontSize="14">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Global hotkey"
                   FontWeight="SemiBold"
                   FontSize="14"
                   Foreground="{StaticResource Brush.Text}"
                   Margin="0,0,0,4"/>

        <TextBlock Grid.Row="1"
                   Text="Click below, then press a key combination (must include Ctrl, Alt, Shift, or Win)."
                   Foreground="{StaticResource Brush.TextMuted}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <Border x:Name="CaptureBox"
                Grid.Row="2"
                Background="{StaticResource Brush.BgAlt}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12,14"
                MinHeight="44"
                Cursor="Hand"
                Focusable="True"
                MouseLeftButtonDown="CaptureBox_MouseLeftButtonDown"
                GotKeyboardFocus="CaptureBox_GotFocus"
                LostKeyboardFocus="CaptureBox_LostFocus"
                PreviewKeyDown="CaptureBox_PreviewKeyDown">
            <TextBlock x:Name="HotkeyText"
                       Text=""
                       FontSize="15"
                       Foreground="{StaticResource Brush.Text}"
                       HorizontalAlignment="Center"/>
        </Border>

        <TextBlock x:Name="HintText"
                   Grid.Row="3"
                   Text=""
                   Foreground="{StaticResource Brush.TextDim}"
                   FontSize="11"
                   Margin="2,6,0,0"/>

        <Grid Grid.Row="4" Margin="0,18,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="Text size"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Text}"/>
            <TextBlock Grid.Row="0" Grid.Column="1"
                       x:Name="FontSizeLabel"
                       Foreground="{StaticResource Brush.TextMuted}"/>
            <Slider Grid.Row="1" Grid.ColumnSpan="2"
                    x:Name="FontSizeSlider"
                    Minimum="11" Maximum="48"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    Margin="0,6,0,0"
                    Foreground="{StaticResource Brush.Accent}"
                    ValueChanged="FontSizeSlider_ValueChanged"/>
        </Grid>

        <StackPanel Grid.Row="5" Margin="0,18,0,0">
            <TextBlock Text="Updates"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Text}"/>
            <TextBlock Text="URL or folder containing latest.json (and the new .exe)"
                       Foreground="{StaticResource Brush.TextMuted}"
                       FontSize="12"
                       Margin="0,2,0,4"/>
            <Border Background="{StaticResource Brush.BgAlt}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="3">
                <TextBox x:Name="UpdateSourceBox"
                         Background="Transparent"
                         Foreground="{StaticResource Brush.Text}"
                         BorderThickness="0"
                         CaretBrush="{StaticResource Brush.AccentBright}"
                         Padding="6,4"/>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Check now"
                        Style="{StaticResource GhostButton}"
                        Click="CheckUpdate_Click"/>
                <TextBlock x:Name="UpdateStatus"
                           Foreground="{StaticResource Brush.TextMuted}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="0,16,0,0">
            <TextBlock x:Name="VersionLabel"
                       Foreground="{StaticResource Brush.TextDim}"
                       FontSize="11"/>
            <TextBlock Foreground="{StaticResource Brush.TextDim}"
                       FontSize="11"
                       Margin="6,0,0,0">
                <Hyperlink Click="License_Click"
                           Foreground="{StaticResource Brush.AccentBright}"
                           TextDecorations="None">License</Hyperlink>
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Clear"
                    Style="{StaticResource GhostButton}"
                    Click="Clear_Click"/>
            <Button Content="Cancel"
                    Style="{StaticResource GhostButton}"
                    Margin="6,0,0,0"
                    Click="Cancel_Click"/>
            <Button Content="OK"
                    Style="{StaticResource AccentButton}"
                    Margin="6,0,0,0"
                    MinWidth="64"
                    IsDefault="True"
                    Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
